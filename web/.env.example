# Supabase 연결 (값은 .env.local 또는 Vercel Environment Variables에 설정, 커밋 금지)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# (선택) OAuth redirectTo 기준 URL — 프로덕션예: https://smart.autofankorea.com
# 로컬에서는 비우거나 http://localhost:3000 (프로덕션 URL이면 로그인 후 그쪽으로 이동)
# NEXT_PUBLIC_SITE_URL=

# 서버 전용 (관리자 작업). 절대 클라이언트에 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# (선택) Geocode — 농장 주소 → lat/lng (서버 전용, Kakao Local API)
# KAKAO_REST_API_KEY=

# (선택) Playwright audit — 기본 http://localhost:3000 (dev 서버 실행 중)
# UI_VERIFY_BASE=http://127.0.0.1:3000

# (선택) LIVE read tier: `list` (default) | `legacy` (full decoded_json on list)
# NEXT_PUBLIC_LIVE_READ_TIER=list

# (선택) 차트 AI 음성 리포팅 PoC — 서버 전용. 값은 .env.local 에만.
# OPENAI_API_KEY=
# VOICE_REPORT_ENABLED=true
# VOICE_MONTHLY_SOFT_USD=20
# VOICE_MONTHLY_HARD_USD=24
# VOICE_MAX_RECORD_SEC=15
# VOICE_MAX_QUESTION_CHARS=200
# VOICE_MAX_ANSWER_CHARS=250
# VOICE_MAX_COST_PER_REQUEST_USD=0.02
# VOICE_RATE_LIMIT_PER_MIN=10
# VOICE_RATE_LIMIT_PER_HOUR=60
# VOICE_TTS_VOICE=alloy
# ARIA 판단 프로토콜 V1 (기본 on). false/0/off 이면 레거시 Chat 요약
# ARIA_PROTOCOL_V1=true
# ARIA 턴 로그(오분류 검수) — 기본 on. false/0/off 이면 비활성
# ARIA_TURN_LOG=true

# (선택) Health 수집 그룹 — farmKeyId 배열 JSON. 미설정 시 농장 목록을 반으로 나눔.
# HEALTH_COLLECTOR_GROUPS={"col-a":["FARM01/P00","FARM02/P00"],"col-b":["FARM06/P00"]}